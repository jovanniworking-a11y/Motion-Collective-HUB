{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ops-panel": {
      "root": "apps/ops-panel",
      "framework": "nextjs"
    },
    "api": {
      "root": "services/api",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    { "source": "/api/agents", "destination": { "service": "api" } },
    { "source": "/api/data", "destination": { "service": "api" } },
    { "source": "/api/routing", "destination": { "service": "api" } },
    { "source": "/api/sims", "destination": { "service": "api" } },
    { "source": "/api/studio", "destination": { "service": "api" } },
    { "source": "/api/agents/(.*)", "destination": { "service": "api" } },
    { "source": "/api/data/(.*)", "destination": { "service": "api" } },
    { "source": "/api/routing/(.*)", "destination": { "service": "api" } },
    { "source": "/api/sims/(.*)", "destination": { "service": "api" } },
    { "source": "/api/studio/(.*)", "destination": { "service": "api" } },
    { "source": "/api/activity", "destination": { "service": "api" } },
    { "source": "/api/usage", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/studio/embed", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "ops-panel" } }
  ]
}
