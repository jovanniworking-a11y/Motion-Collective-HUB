# MOTION Ops Panel — cloud / local env (never commit real secrets)

# Public URL of the FastAPI control plane (no trailing slash).
# Local default if unset: http://127.0.0.1:8787
# Cloud (Vercel / Railway): set in the host dashboard at build + runtime.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
# Alias still accepted by the client:
# NEXT_PUBLIC_MOTION_API_URL=http://127.0.0.1:8787

# Anthropic API key is OPTIONAL (server-side Next route /assist only).
# Without it the panel runs in Pro bridge mode: local mock Assist +
# "Open in Claude.ai" / "Copy prompt" so you use Claude.ai Pro/Max in the browser ($0 API).
# Claude.ai Pro/Max subscription does NOT include API access — that is a separate Anthropic product.
#
# Server-side only — never expose to the browser or commit real keys.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514
