# MOTION Control Plane API — cloud / local env (never commit real secrets)

# Listen port (Fly/Railway inject PORT automatically)
# PORT=8787

# Writable store for SQLite usage DB + layout/chat JSON.
# Cloud MVP without a volume: use /tmp (resets on redeploy — expected).
# MOTION_DATA_DIR=/tmp/motion-api-data

# Repo root when layout differs from source tree (Docker image sets this implicitly via paths)
# MOTION_REPO_ROOT=/srv

# Comma-separated browser origins allowed to call this API (panel URL(s))
MOTION_API_CORS=http://localhost:3000,http://127.0.0.1:3000
# MOTION_API_CORS=https://YOUR-PANEL.vercel.app,http://localhost:3000

# Optional Anthropic Messages API (billed). Omit for mock chat + Pro Prompt Bridge on the panel.
# ANTHROPIC_API_KEY=

# Real studio sim scripts (off by default)
# MOTION_SIM_EXECUTE=0

# Muse data platform (SQLite default under MOTION_DATA_DIR; Postgres-ready)
# DATABASE_URL=sqlite:////tmp/motion-api-data/muse_platform.sqlite3
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/motion
